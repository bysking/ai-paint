; 项目级 npm 配置 — 发布 @bysking/b-code 使用
; 运行 `npm login` 后会自动写入 _authToken
; 注意：此文件包含敏感 token，已加入 .gitignore，请勿提交

registry=https://registry.npmjs.org/

; @bysking scope 也走官方源（默认继承上面的 registry，这里显式声明更清晰）
@bysking:registry=https://registry.npmjs.org/

; 发布时始终用 public access（scoped package 默认是 restricted）
access=public
